{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(rm -rf:*)",
        "hooks": [{ "type": "command", "command": "echo 'blocked: destructive rm needs human approval (H1)' >&2; exit 2" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "python3 -m py_compile \"$FILE\" 2>/dev/null || true" }]
      }
    ]
  }
}
