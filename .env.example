# Copy to .env and fill LOCALLY. Never commit .env, never paste keys in chat.
# Only variable NAMES travel; values stay on your machine.

HR_BACKEND=sqlite
HR_DB=data/dev.db

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
# Warehouses: comma-separated, max 3 (first = default). Single SNOWFLAKE_WAREHOUSE works too.
SNOWFLAKE_WAREHOUSES=WH_AGENT,WH_ANALYTICS,WH_INGEST
# Database optional: leave empty to connect with no default DB (see/use all databases).
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=HR_DEMO

# Programmatic access token (PAT, generated in Snowflake) — use when you have one:
SNOWFLAKE_PAT=
# Key-pair auth (alternative):
SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake_key.p8
# Fallback only — prefer the token or key above:
# SNOWFLAKE_PASSWORD=

# Tableau MCP server (Node.js 18+ with npx; see .mcp.json) — fill LOCALLY only:
TABLEAU_SERVER=
TABLEAU_SITE=
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=
